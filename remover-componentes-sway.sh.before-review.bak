#!/usr/bin/env bash
set -euo pipefail
if [ "$(id -u)" = 0 ]; then
    echo 'Execute como seu usuário normal; o script solicita sudo quando necessário.' >&2
    exit 1
fi
for binary in niri noctalia alacritty swaybg; do command -v "$binary" >/dev/null; done
niri validate --config "$HOME/.config/niri/config.kdl"
noctalia config validate
python3 - <<'PY'
from pathlib import Path
p=Path.home()/'.config/niri/config.kdl'
if 'spawn-at-startup "noctalia"' not in p.read_text():
    raise SystemExit('Noctalia não está configurado para iniciar com Niri.')
PY
task_tmp=$(mktemp -d)
trap 'rm -rf -- "$task_tmp"' EXIT
rpm-ostree status --json > "$task_tmp/status.json"
python3 - "$task_tmp" <<'PY'
import json,subprocess,sys
from pathlib import Path
root=Path(sys.argv[1])
status=json.loads((root/'status.json').read_text())
deployments=status['deployments']
if any(d.get('staged') for d in deployments):
    raise SystemExit('Há uma implantação pendente. Reinicie primeiro e execute novamente.')
deployment=next(d for d in deployments if d.get('booted'))
layered=set(deployment.get('requested-packages',[])) | set(deployment.get('packages',[]))
candidates='foot fuzzel sway sway-config-fedora sway-systemd sddm-wayland-sway waybar dunst rofi rofi-themes grimshot swayidle swaylock wlsunset kanshi wlr-randr xdg-desktop-portal-wlr wlroots0.19'.split()
installed=[p for p in candidates if subprocess.run(['rpm','-q',p],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0]
if not installed: raise SystemExit('Nenhum dos pacotes selecionados está instalado.')
print('Verificando dependências dos pacotes a remover:', ', '.join(installed),flush=True)
check=subprocess.run(['rpm','-e','--test',*installed],capture_output=True,text=True)
if check.returncode:
    problems=[line.strip() for line in check.stderr.splitlines() if line.strip() and line.strip()!='error: Failed dependencies:']
    # O provedor do display server será substituído na mesma transação.
    if not problems or any(not line.startswith('sddm-greeter-displayserver is needed by (installed) sddm-') for line in problems):
        raise SystemExit(check.stderr)
(root/'base').write_text('\n'.join(p for p in installed if p not in layered)+'\n')
(root/'layered').write_text('\n'.join(p for p in installed if p in layered)+'\n')
PY
mapfile -t base_packages < <(sed '/^$/d' "$task_tmp/base")
mapfile -t layered_packages < <(sed '/^$/d' "$task_tmp/layered")
if [ "${#base_packages[@]}" -eq 0 ]; then
    echo 'A lista não contém pacotes da imagem base; revise a transação manualmente.' >&2
    exit 1
fi
transaction=(rpm-ostree override remove "${base_packages[@]}")
for package in "${layered_packages[@]}"; do transaction+=("--uninstall=$package"); done
if ! rpm -q weston >/dev/null 2>&1; then transaction+=(--install=weston); fi
if ! rpm -q sddm-wayland-generic >/dev/null 2>&1; then transaction+=(--install=sddm-wayland-generic); fi
# A simulação resolve a transação antes de modificar a configuração do SDDM.
sudo "${transaction[@]}" --dry-run
# Preserve o tema que pertence ao pacote sddm-wayland-sway.
sudo python3 - "$task_tmp" <<'PY'
from pathlib import Path
import datetime,shutil,sys
backup=Path('/var/backups/sddm')/('before-remove-sway-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
backup.mkdir(parents=True)
config=Path('/etc/sddm.conf.d/zz-kobold-greeter.conf')
if config.exists(): shutil.copy2(config,backup/config.name)
source=Path('/usr/share/sddm/themes/03-sway-fedora')
target=Path('/usr/local/share/sddm/themes/kobold')
if not source.is_dir(): raise SystemExit('Tema do SDDM não encontrado; nenhuma remoção aplicada.')
if target.exists(): shutil.copytree(target,backup/'theme',symlinks=True)
shutil.copytree(source,target,dirs_exist_ok=True,symlinks=True)
Path(sys.argv[1],'backup').write_text(str(backup))
print('Backup do SDDM:',backup)
PY
sudo "${transaction[@]}"
sudo python3 - <<'PY'
from pathlib import Path
p=Path('/etc/sddm.conf.d/zz-kobold-greeter.conf')
p.parent.mkdir(parents=True,exist_ok=True)
p.write_text('[General]\nDisplayServer=wayland\nGreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=xdg-shell\nInputMethod=\n\n[Theme]\nThemeDir=/usr/local/share/sddm/themes\nCurrent=kobold\n\n[Wayland]\nCompositorCommand=/usr/bin/weston --shell=kiosk-shell.so\n')
p.chmod(0o644)
PY
echo 'Transação preparada. Reinicie o computador para aplicar. Não reinicie apenas o SDDM antes disso.'
echo 'Niri, Noctalia, Alacritty, swaybg, portais GNOME/GTK e serviços de áudio/rede foram preservados.'
echo 'Para desfazer: remova /etc/sddm.conf.d/zz-kobold-greeter.conf, execute sudo rpm-ostree rollback e reinicie.'
