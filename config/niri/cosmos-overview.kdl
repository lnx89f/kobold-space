// Dedicated wallpaper behind workspaces in the overview.
overview {
    backdrop-color "#000000"
    workspace-shadow {
        off
    }
}

layout {
    background-color "transparent"
}

// Hide the workspace wallpaper while retaining Noctalia's wallpaper selection.
layer-rule {
    match namespace="^noctalia-wallpaper$"
    opacity 0.0
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

spawn-at-startup "swaybg" "-i" "@HOME@/.local/share/backgrounds/niri/cosmos-minimal-pixel.png" "-m" "fill"

// Open the overview explicitly instead of using screen corners.
gestures {
    hot-corners {
        off
    }
}
