// Dedicated wallpaper behind workspaces in the overview.
overview {
    backdrop-color "#000000"
    workspace-shadow {
        off
    }
}

layout {
    background-color "transparent"
}

// Let Noctalia manage the wallpaper, including the overview backdrop.
layer-rule {
    match namespace="^noctalia-wallpaper$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}


// Open the overview explicitly instead of using screen corners.
gestures {
    hot-corners {
        off
    }
}
