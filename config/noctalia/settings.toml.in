config_version = 14

[bar.default]
background_opacity = 0.0
end = [ "media", "tray", "network", "bluetooth", "brightness", "battery", "volume" ]
margin_ends = 0
padding = 0
start = [ "overview", "launcher" ]
thickness = 22

[lockscreen_widgets]
enabled = false
schema_version = 2
widget_order = [ "lockscreen-login-box@eDP-1" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@eDP-1"]
    box_height = 196.0
    box_width = 810.0
    cx = 960.0
    cy = 898.0
    output = "eDP-1"
    placement_height = 1080.0
    placement_width = 1920.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@eDP-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

[plugins]
enabled = [ "kobold/workspaces-outline" ]

[shell.panel]
launcher_placement = "attached"
open_near_click_launcher = true

[theme]
builtin = "Eldritch"
custom_palette = "kobold-matrix"
mode = "dark"
pure_black_dark = true
shell_mode = "dark"
source = "custom"
wallpaper_scheme = "m3-monochrome"

    [theme.templates]
    builtin_ids = [ "alacritty", "btop", "niri" ]
    community_ids = [ "codex", "telegram" ]

[wallpaper.default]
path = "@HOME@/.local/share/backgrounds/kobold/kobold-wallpaper.png"

[wallpaper.last]
path = "@HOME@/.local/share/backgrounds/kobold/kobold-wallpaper.png"

[wallpaper.monitors.eDP-1]
path = "@HOME@/.local/share/backgrounds/kobold/kobold-wallpaper.png"

[widget.audio_visualizer]
color_1 = "on_surface_variant"
color_2 = "on_surface_variant"

[widget.battery]
show_label = false

[widget.brightness]
show_label = false

[widget.clock]
format = "   {:%H:%M}   "

[widget.launcher]
glyph = "menu"

[widget.media]
glyph = "player-play"
label = ""
tooltip = "Mídia"
type = "custom_button"

    [widget.media.actions]
    back = "media previous"
    forward = "media next"
    left = "panel-toggle control-center media"
    right = "media toggle"

[widget.network]
show_label = false

[widget.overview]
glyph = "selector"
scroll_repeat = "steps"
type = "custom_button"

    [widget.overview.actions]
    left = "exec niri msg action toggle-overview"
    scroll_down = "workspace-switch down"
    scroll_up = "workspace-switch up"

[widget.tray]
hidden = [ "nm-applet", "blueman", "blueman-applet" ]

[widget.volume]
mute_color = "hover"
show_label = false

[widget.workspaces]
font_scale = 1.1000000000000001
scale = 1.1000000000000001
type = "kobold/workspaces-outline:workspaces"

    [widget.workspaces.actions]
    right = "screenshot-fullscreen"
